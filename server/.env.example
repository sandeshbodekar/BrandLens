PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=20000
# Round 3: embeddings for matching claims to approved facts. Must be an EMBEDDING model
# (gemini-embedding-2 or gemini-embedding-001), not a text model. Leave empty to turn it off.
LLM_EMBED_MODEL=gemini-embedding-2
LLM_EMBED_DIMENSIONS=768
